# DocuQuery Python Service Environment Variables
# Copy this file to .env and fill in your values.
# Keep secrets out of source control.

GROQ_API_KEY=your_groq_api_key_here

# Required in production (DOCUQUERY_ENV=production): at least 16 characters.
# Must match PYTHON_INTERNAL_TOKEN in node-service/.env.
PYTHON_INTERNAL_TOKEN=replace-with-at-least-16-random-characters

DOCUQUERY_ENV=development

# Qdrant Cloud or another remote Qdrant server.
# When QDRANT_URL is set, local storage is not used.
# QDRANT_API_KEY is a secret; never commit a real value.
QDRANT_URL=
QDRANT_API_KEY=

# Local embedded mode only (used when QDRANT_URL is empty).
# QDRANT_STORAGE_PATH=./qdrant_storage
