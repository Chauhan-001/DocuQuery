# DocuQuery - Root Environment Variables Example
# Copy to .env and fill in your values.
# Keep secrets out of source control.

# Frontend (Vite reads this at build time; redeploy after changing it)
VITE_API_URL=http://localhost:3000

# Node.js API Service
NODE_ENV=development
PORT=3000
PYTHON_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
# Optional: override the bundled sample PDF path. The default is repo-relative.
# DEFAULT_DOCUMENT_PATH=../python-service/rag-content.pdf

# Session secret: use at least 32 random characters in production.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Session lifetime in milliseconds (default: 24 hours).
SESSION_TTL_MS=86400000

# Shared Node <-> Python internal token: use the same value in the Python
# service. Use at least 16 random characters in production.
PYTHON_INTERNAL_TOKEN=replace-with-at-least-16-random-characters

# Per-session limits
MAX_DOCS_PER_SESSION=10
INGEST_RATE_LIMIT=6
INGEST_RATE_WINDOW_MS=600000
ANSWER_RATE_LIMIT=20
SEARCH_RATE_LIMIT=60

# Python AI Service
DOCUQUERY_ENV=development
GROQ_API_KEY=your_groq_api_key_here

# Qdrant: set QDRANT_URL to use Qdrant Cloud or another remote server.
# Leave it empty to use the local embedded database for development.
# QDRANT_API_KEY is a secret; never commit a real value.
QDRANT_URL=
QDRANT_API_KEY=
# Local embedded mode only:
# QDRANT_STORAGE_PATH=./qdrant_storage
