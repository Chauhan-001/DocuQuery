# DocuQuery Node.js Service Environment Variables
# Copy this file to .env and fill in your values.
# Keep secrets out of source control.

NODE_ENV=development
PORT=3000
PYTHON_API_URL=http://127.0.0.1:8000
# Comma-separated list of exact frontend origins.
FRONTEND_ORIGIN=http://localhost:5173

# Required in production (NODE_ENV=production): at least 32 characters.
# In development an ephemeral secret is generated when this is unset.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MS=86400000

# Must match PYTHON_INTERNAL_TOKEN in python-service/.env.
# Required in production: at least 16 characters.
# In development both services fall back to a shared development token.
PYTHON_INTERNAL_TOKEN=replace-with-at-least-16-random-characters

# Per-session upload and request limits.
MAX_DOCS_PER_SESSION=10
INGEST_RATE_LIMIT=6
INGEST_RATE_WINDOW_MS=600000
ANSWER_RATE_LIMIT=20
SEARCH_RATE_LIMIT=60
